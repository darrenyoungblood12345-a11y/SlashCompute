;; /compute worker profile. Deny-by-default with the allowances Metal, Python
;; and the job directory need. Paths are substituted by sandbox-exec -D.
(version 1)
(deny default)
(allow process-exec)
(allow process-fork)
(allow signal)
(allow sysctl-read)
(allow mach-lookup)
(allow mach-register)
(allow iokit-open)
(allow ipc-posix-shm)
(allow ipc-posix-sem)
(allow file-read*)
(allow file-write-data
       (subpath (param "JOBDIR"))
       (subpath (param "AGENTDIR"))
       (subpath (param "TMPDIR"))
       (subpath "/tmp")
       (subpath "/private/tmp")
       (subpath "/private/var/folders")
       (regex #"^/Users/.*/Library/Caches"))
(allow file-write-create
       (subpath (param "JOBDIR"))
       (subpath (param "AGENTDIR"))
       (subpath (param "TMPDIR"))
       (subpath "/tmp")
       (subpath "/private/tmp")
       (subpath "/private/var/folders")
       (regex #"^/Users/.*/Library/Caches"))
(allow file-write-unlink
       (subpath (param "JOBDIR"))
       (subpath (param "AGENTDIR"))
       (subpath (param "TMPDIR"))
       (subpath "/tmp")
       (subpath "/private/tmp")
       (subpath "/private/var/folders"))
(allow network*)
(allow system-socket)
